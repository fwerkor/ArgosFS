[package]
name = "reed-solomon-engine"
version = "0.2.0"
edition = "2024"
rust-version = "1.85"
license = "MIT OR Apache-2.0"
description = "Dependency-free, no_std Reed-Solomon erasure coding over GF(2^8)"
repository = "https://github.com/stephenberry/reed-solomon-engine"
readme = "README.md"
keywords = ["reed-solomon", "erasure", "fec", "galois", "no_std"]
categories = ["encoding", "algorithms", "no-std"]
# `benches/harness.rs` is a shared module, not a target of its own.
autobenches = false
# `/tmp` holds scratch build directories. It is git-ignored, but `cargo package`
# only honours that when the working tree is in a state it can read from git, so
# the exclusion is stated here as well rather than assumed. `/ci` is a separate
# workspace and `/.github` is of no use to a consumer. `/dev` is working
# material about where this crate is going, which belongs in the repository and
# not in a released tarball; the README links to it, and crates.io resolves
# relative links against the repository, so the link still works. `docs/DESIGN.md`
# and `docs/WIRE_FORMAT.md` are the two a consumer needs, so `/docs` ships.
exclude = ["/tmp", "/ci", "/.github", "/dev"]

# Zero runtime dependencies. This section is intentionally empty and must stay
# that way; see docs/DESIGN.md.
[dependencies]

[features]
default = ["std"]
# Owned-buffer conveniences (`Encoder`, `Decoder`). Allocation happens only in
# the constructors; encode and decode never allocate.
alloc = []
# Implies `alloc`. Reserved for runtime CPU feature detection once SIMD kernels
# land.
std = ["alloc"]

[dev-dependencies]
# Benchmark comparison target only. Never a runtime dependency.
reed-solomon-simd = "3"

[lib]
# The unit tests have no `#[bench]` functions, and letting `cargo bench` run
# their libtest harness anyway means it rejects the custom harness's flags
# before the real benchmarks get a chance to run.
bench = false

# The sweep. `cargo bench` runs this one.
[[bench]]
name = "bench"
harness = false

# The head-to-head against the incumbents. Excluded from a bare `cargo bench`
# because it is slow and pointless during ordinary development; run it with
# `cargo bench --bench comparison`.
[[bench]]
name = "comparison"
harness = false
bench = false

[profile.test]
opt-level = 2

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]
